// -*- mode: jsonc -*-
{
    "reload_style_on_change": true,

    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 3,

    "include": [
        "~/.config/waybar/hyprwhspr-module-niri.jsonc",
        "~/.config/waybar/waybar-clock.json"
    ],

    "modules-left": [
        // "group/activity"
        "group/times"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "custom/hyprwhspr",
        "group/utils",
        "group/system-state"
    ],

    // "group/activity": {
    //     "orientation": "horizontal",
    //     "spacing": 30,
    //
    //     "drawer": {
    //         "transition-duration": 500,
    //         "transition-left-to-right": true
    //     },
    //
    //     "modules": [
    //         "custom/pomodoro",
    //         "hyprland/window"
    //     ]
    // },

  "group/times": {
    "orientation": "horizontal",
    "spacing": 30,
    "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": true
    },
    "modules": [
    "clock",
    "custom/timer",
    "custom/pomodoro"
    ]
  },

  "group/system-state": {
    "orientation": "horizontal",
    "spacing": 30,
    "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": false
    },
    "modules": [
      "custom/batterycheck",
      "memory",
      "cpu",
      "temperature",
      "custom/power"
      // "power-profiles-daemon"
    ]
  },
  "group/utils": {
    "orientation": "horizontal",
    "spacing": 30,
    "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": false
    },
    "modules": [
        "tray",
        "pulseaudio",
        "custom/pacupdate",
        "network",
    ]
  },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "on-click": "activate",

        "format": "{icon}",

        "format-icons": {
            "1": "০",
            "2": "১",
            "3": "২",
            "4": "৩",
            "5": "৪",
            "6": "৫",
            "7": "৬",
            "8": "৭",
            "9": "৮",
            "10": "৯"
        }
    },

    "tray": {
        "spacing": 10
    },

    "cpu": {
        "format": "{usage}% ",
        "interval": 30
    },

    "memory": {
        "format": "{}% ",
        "interval": 30
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C{icon}",
        "format-icons": [
            "󰔄",
            "󰔏",
            "󰔐"
        ]
    },

    "custom/pacupdate": {
        "exec": "$HOME/.local/bin/waybar-update-tracker",
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "tooltip-format": "{alt}",
        "on-click": "alacritty -e sudo pacman -Syu && sudo paru -Sua",
        "interval": 60
    },

    "custom/pomodoro": {
        "format": "{}",
        "exec": "$HOME/.local/bin/waybar-pomodoro",
        "return-type": "json",
        "interval": 1,

        "on-click": "$HOME/.local/bin/waybar-pomodoro toggle",
        "on-click-right": "$HOME/.local/bin/waybar-pomodoro cycle",
        "on-click-middle": "$HOME/.local/bin/waybar-pomodoro stop"
    },

    "custom/timer": {
        "format": "{}",
        "exec": "$HOME/.config/waybar/scripts/waybar-stopwatch",
        "return-type": "json",
        "interval": 1,

        "on-click": "$HOME/.config/waybar/scripts/waybar-stopwatch toggle",
        "on-click-right": "$HOME/.config/waybar/scripts/waybar-stopwatch reset"
    },

    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },

    "custom/batterycheck": {
        "exec": "$HOME/.config/waybar/scripts/waybar-battery-update.sh",
        "return-type": "json",
        "interval": 10,

        "format": "{icon} {text}",

        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip": true
    },

    "power-profiles-daemon": {
        "format": " {icon} ",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,

        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "network": {
        "tooltip": true,
        "rotate": 0,

        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",

        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>",

        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",

        "format-alt": "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",

        "interval": 2
    },

    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} 󰂯 {format_source}",
        "format-bluetooth-muted": "󰅶 {icon} 󰂯 {format_source}",
        "format-muted": "󰅶 {format_source}",
        "format-source": "{volume}% 󰍬",
        "format-source-muted": "󰍭",

        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰂑",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "speaker": "󰓃",
            "hdmi": "󰡁",
            "hifi": "󰋌",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },

        "on-click": "pavucontrol"
    },

    "custom/power": {
        "format": "⏻ ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/power-menu"
    }
}
