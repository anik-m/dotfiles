// -*- mode: jsonc -*-
{
    "reload_style_on_change": true,
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 3, // Gaps between modules (4px)
    "include": [
        "/home/nika/.config/waybar/hyprwhspr-module-niri.jsonc",
        "/home/nika/.config/waybar/waybar-clock.json"
    ],
    // Choose the order of the modules
      "modules-left": [
        "group/times"
      ],
      "modules-center": [
        "niri/workspaces"
      ],
      "modules-right": [
        "custom/hyprwhspr",
        "group/utils",        // <-- GROUP
        "group/system-state"       // <-- GROUP
      ],
      "group/times": {
        "orientation": "horizontal",
        "spacing": 30,
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
        "clock",
        "custom/timer",
        "custom/pomodoro"
        // "niri/window"
        ]
      },
      "group/system-state": {
        "orientation": "horizontal",
        "spacing": 30,
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": [
          "custom/batterycheck",
          "memory",
          "cpu",
          "temperature",
          "custom/power"
          // "power-profiles-daemon"
        ]
      },
      "group/utils": {
        "orientation": "horizontal",
        "spacing": 30,
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": [
            "tray",
            "pulseaudio",
            "custom/pacupdate",
            "network",
        ]
      },
    // Modules configuration

    "niri/workspaces": {
        // "disable-scroll": true,
        // "tooltip": true,
        // "show-empty": false,
        
        "format": "{icon}",
        "format-icons": {
            //"1": "",
            //"2": "",
            //"3": "",
            //"4": "",
            //"5": "",
            "1": "০",
            "2": "১",
            "3": "২",
            "4": "৩",
            "5": "৪",
            "6": "৫",
            "7": "৬",
            "8": "৭",
            "9": "৮",
            "10": "৯",
            //"urgent": "",
            //"focused": "",
            //"default": ""

        }
        //hyprland specifc options
        // "all-outputs": true,
        // "warp-on-scroll": false,
        //"format": "{name}: {icon}",
    },

