    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },

    // "clock": {
    //     "tooltip-format": "<tt><small>{calendar}</small></tt>",
    //     "format-alt": "{:%d-%m-%Y}",
    //     "calendar": {
    //         "mode": "month",
    //         "format": {
    //             "months": "<b>{}</b>",
    //             "days": "{}",
    //             "weekdays": "<b>{}</b>",
    //             "today": "<b><u>{}</u></b>"
    //         }
    //     }
    // },

//     "clock": {
// "tooltip-format": "<big>{:%Y %B}</big>\n<span font='JetBrainsMono Nerd Font 12pt'>{calendar}</span>",
//         "format-alt": "{:%d-%m-%Y}",
//         "calendar": {
//                     "mode": "month",
//                     "format": {
//                         "months": "<span color='#ff6699'><b>{}</b></span>",
//                         "days": "<span color='#cdd6f4'>{}</span>",
//                         "weekdays": "<span color='#7CD37C'><b>{}</b></span>",
//                         "today": "<span color='#ffcc66'><b>{}</b></span>"
//             }
