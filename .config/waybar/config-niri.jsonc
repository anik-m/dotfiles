    "cpu": {
        "format": "{usage}% ",
        //"tooltip": false,
        "interval":30
    },

    "memory": {
        "format": "{}% ",
        "interval":30
    },
    
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C{icon}",
        // "format-icons": ["", "", ""]
        "format-icons": ["󰔄", "󰔏", "󰔐"]
    },

    "custom/pacupdate": {
        "exec": "/home/nika/.local/bin/waybar-update-tracker",
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "tooltip-format": "{alt}", 
        // "format-icons": {
        //     "has-updates": "󱍷",
        //     "updated": "👍"
        // },
        // "exec-if": "which waybar-module-pacman-updates",
        "on-click": "alacritty -e sudo pacman -Syu && sudo paru -Sua",
        "interval":60
    },

    "custom/pomodoro": {
        "format": "{}",
        "exec": "$HOME/.local/bin/waybar-pomodoro",
        "return-type": "json",
        "interval": 1,
        // Add the full path to ALL click commands:
        "on-click": "$HOME/.local/bin/waybar-pomodoro toggle",
        "on-click-right": "$HOME/.local/bin/waybar-pomodoro cycle",
        "on-click-middle": "$HOME/.local/bin/waybar-pomodoro stop"
    },

    "custom/timer": {
        "format": "{}",
        "exec": "$HOME/.config/waybar/scripts/waybar-stopwatch",
        "return-type": "json",
        "interval": 1,

        "on-click": "$HOME/.config/waybar/scripts/waybar-stopwatch toggle",
        "on-click-right": "$HOME/.config/waybar/scripts/waybar-stopwatch reset"
    },
    
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    
    "custom/batterycheck": {
        "exec": "$HOME/.config/waybar/scripts/waybar-battery-update.sh",
        "return-type": "json",
        "interval": 10,

        "format": "{icon} {text}",

        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip": true
    },

    // "custom/batterycheck": {
    //   "exec": "$HOME/.config/waybar/scripts/waybar-battery-update.sh",
    //   "return-type": "json",
    //   "interval": 10,
    //   "format": "{text}", 
    //   "tooltip-format": "{alt}",
    //   "states": {
    //     "warning": 30,
    //     "critical": 15
    //   }
    // },
    //
    "power-profiles-daemon": {
          "format": " {icon} ",
          "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
          "tooltip": true,
          "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
          }
    },

    // "network": {
    //     "tooltip": true,
    //     "rotate": 0,
    //
    //     "format-wifi": "{essid} ({signalStrength}%) ",
    //     "format-ethernet": "{ipaddr}/{cidr} 󰈀",
    //     "format-linked": "{ifname} (No IP) 󰈀",
    //     "format-disconnected": "Disconnected ⚠",
    //
    //     "tooltip-format-wifi": "Network: <big><b>{essid}</b></big>\nSignal: <b>{signaldBm} dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency} MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>",
    //     "tooltip-format-ethernet": "Interface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>",
    //     "tooltip-format-disconnected": "Network disconnected",
    //
    //     "format-alt": "<span foreground='#99ffdd'>󰇚 {bandwidthDownBytesCompact}</span> <span foreground='#ffcc66'>󰕒 {bandwidthUpBytesCompact}</span>",
    //
    //     "on-click": "~/.local/bin/network-menu",
    //
    //     "interval": 2
    // },

    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "tooltip": true,
        "rotate": 0,
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        //"tooltip-format": "{ifname} via {gwaddr} ",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
        "interval": 2  
        //"format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} 󰂯 {format_source}",
        "format-bluetooth-muted": "󰅶 {icon} 󰂯 {format_source}",
        "format-muted": "󰅶 {format_source}",
        "format-source": "{volume}% 󰍬",
        "format-source-muted": "󰍭",

        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰂑",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "speaker": "󰓃",
            "hdmi": "󰡁",
            "hifi": "󰋌",
            "default": ["󰕿", "󰖀", "󰕾"]
        },

        // "on-click": "pavucontrol"
        // "on-click": "qs ipc call audio toggle"

        "on-click": "qs -c $HOME/.config/quickshell/audio ipc call audio toggle"
    },

    "custom/power": {
        "format" : "⏻ ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/power-menu"
    }
    // "custom/power": {
    //     "format" : "⏻ ",
    //     "tooltip": false,
    //     "menu": "on-click",
    //     "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
