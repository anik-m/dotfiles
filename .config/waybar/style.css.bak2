@import "/usr/lib/hyprwhspr/config/waybar/hyprwhspr-style.css";
* {
    border: none;
    border-radius: 0;
    font-family: "Ubuntu Nerd Font bold";
    font-size: 13px;
    min-height: 0;
}

window#waybar {
    background: rgba(43, 48, 59, 0.5); /* Semi-transparent dark background - GOOD for light and dark */
    color: #f8f8f2;         /* Light text - GOOD for light and dark */
    transition-property: background-color;
    transition-duration: .5s;
}

window#waybar.hidden {
    opacity: 0.2;
}

/* makes it so that windows can be transparent */
window#waybar.empty {
    background-color: transparent;
}
window#waybar.empty #window {
    padding: 0px;
    border: none;
    background-color: transparent;
}

#window {
    font-weight: bold;
    font-family: "Ubuntu";
    margin-top: 2px;
    border-radius: 10px;
    /*padding: 0px 20px;*/
    /*margin-bottom: 0px;*/
    /*margin: 4px;*/
}

/*
#workspaces {
    padding: 0 5px;
}
*/

#workspaces button {
    padding: 0 5px;
    background-color: transparent;
    color: #f8f8f2;  /* Light text - GOOD for light and dark */
    border-top: 2px solid transparent;

}

/* https://github.com/Alexays/Waybar/wiki/FAQ#the-workspace-buttons-have-a-strange-hover-effect */
#workspaces button:hover {
    background: rgba(0, 0, 0, 0.2);
    box-shadow: inherit;
    border-color: transparent;

}

#workspaces button.focused {
    color: #a9d18e;  /* Lighter green - visible on light & dark */
    background-color: rgba(0, 0, 0, 0.3);
    border-top: 2px solid #a9d18e;  /* Lighter green - visible on light & dark */
    border-radius: 10px;
}

#workspaces button.urgent {
    background-color: #eb4d4b;
}
#workspaces button.active {
    /* Text (icon) colour */
    color: #ffffff;          /* white text */

    /* Background colour – change this to whatever you like */
    /* a nice blue   */
    /* background: #3b82f6; */
    /* background: rgba(0, 0, 0, 0.2); */
    /* Optional: a subtle border or radius */
    /* border-radius: 4px; */
    /* border: 2px solid #1e40af; */

    /* A larger radius for a "bubbly" feel */
    /* border-radius: 9999px;  */

    /* Add a line underneath */
    /* border-bottom: 3px solid #ffffff;  */
    
    /* Or a line on top */
    border-top: 3px solid #ffffff;
}
#mode {
    background: #64727D;
    border-bottom: 3px solid #f8f8f2; /* Light border */
}

#clock,
#custom-batterycheck,
#cpu,
#memory,
#temperature,
#power-profiles-daemon,
#network,
#pulseaudio,
#custom-pacupdate,
#tray,
#custom-power,
#mode {
    padding: 0 8px;  /* Slightly reduced padding for tighter look */
    margin: 2px 2px; /*Consistent spacing around*/
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.3);  /* Semi-transparent black - works well on light and dark */
}

#clock {
    color: #a9d18e; /* Lighter green */
    font-weight: bold;
}


/* ================================
 * Battery Check
 * ================================ */

#custom-batterycheck {
    color: #f8f8f2;
    background-color: rgba(40, 42, 54, 0.85);

    /* padding: 0 9px; */
    /* margin: 0 3px; */

    border-radius: 6px;

    min-width: 55px;

    transition:
        color 200ms ease,
        background-color 200ms ease;
}

/* Icon */
#custom-batterycheck icon {
    color: #f8f8f2;
}

/* ================================
 * Charging
 * ================================ */

#custom-batterycheck.charging {
    color: #b8e994;
    background-color: #268bd2;

    box-shadow: 0 0 6px rgba(38, 139, 210, 0.45);

    animation: charging-pulse 2s ease-in-out infinite;
}

#custom-batterycheck.charging icon {
    color: #dfffe0;
}

@keyframes charging-pulse {
    0% {
        background-color: #268bd2;
    }

    50% {
        background-color: #2f9ee8;
    }

    100% {
        background-color: #268bd2;
    }
}

/* ================================
 * Warning / Low Battery
 * ================================ */

#custom-batterycheck.warning:not(.charging) {
    color: #ffffff;
    background-color: #f53c3c;

    box-shadow: 0 0 8px rgba(245, 60, 60, 0.5);

    animation: battery-warning 0.9s ease-in-out infinite alternate;
}

#custom-batterycheck.warning:not(.charging) icon {
    color: #ffffff;
}

@keyframes battery-warning {
    from {
        background-color: #f53c3c;
        box-shadow: 0 0 4px rgba(245, 60, 60, 0.35);
    }

    to {
        background-color: #ff6666;
        box-shadow: 0 0 10px rgba(245, 60, 60, 0.75);
    }
}

/* ================================
 * Tooltip
 * ================================ */

tooltip {
    font-size: 0.85rem;

    padding: 6px 10px;

    background-color: rgba(30, 30, 30, 0.94);
    color: #fafafa;

    border-radius: 5px;

    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.35);
}


@keyframes blink {
    to {
        background-color: #ffffff;
        color: #000000;
    }
}
/* --- THIS IS THE FIX --- */
#custom-batterycheck.warning:not(.charging) {
    color: #f8f8f2;
    background-color: #f53c3c;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}


tooltip {
    font-size: 0.85rem;
    padding: 6px 10px;
    background: rgba(30,30,30,0.94);
    color: #fafafa;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.35);
}

#cpu {
    color: #f8f8f2; /* Light text */
}

#memory {
     color: #f8f8f2; /* Light text */
}

#network {
    color: #f8f8f2; /* Light text */
}

#network.disconnected {
    background: #f53c3c;
    color: #f8f8f2;
}

#pulseaudio {
    color: #f8f8f2;
}

#pulseaudio.muted {
    color: #64727D;
    background: #f53c3c;

}

#custom-pacupdate {
     color: #a9d18e; /* Lighter Green*/
}

#custom-pomodoro {
    padding: 0 10px;
    border-radius: 8px;
    color: #ffffff;
}

#custom-pomodoro.work 
/* { 
      background-color: #555555;  Gray for work
 } */

#custom-pomodoro.short-break {
    background-color: #4caf50; /* Green for short break */
}

#custom-pomodoro.long-break {
    background-color: #2196f3; /* Blue for long break */
}

#custom-pomodoro.paused {
    background-color: #ff9800; /* Orange for paused */
    color: #333333;
}

#custom-pomodoro.finished {
    background-color: #9c27b0; /* Purple for finished */
    animation: blink 1s ease-in-out infinite;
}

#custom-pomodoro.stopped {
    background-color: #f44336; /* Red for stopped */
}

#custom-timer {
    padding: 0 8px;
    margin: 2px 2px 2px -5px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.3);
    color: #89dceb;
}

#custom-timer.running {
    color: #a6e3a1;
}

#custom-timer.stopped {
    color: #f9e2af;
}

/* A simple blinking animation for the 'finished' state */
@keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0.5; }
    100% { opacity: 1; }
}
#tray {

}
