
@import "/usr/lib/hyprwhspr/config/waybar/hyprwhspr-style.css";
@import "colors.css";
/* ============================================================
 * GLOBAL
 * ============================================================ */

* {
    border: none;
    border-radius: 0;
    /* font-family: "Ubuntu Nerd Font Bold"; */
	font-family: "Ubuntu", "JetBrainsMono Nerd Font Propo", sans-serif;
    font-size: 13px;
    min-height: 0;
}

/* ============================================================
 * WAYBAR WINDOW
 * ============================================================ */


window#waybar {
    background: transparent;
    color: #f8f8f2;
}

