/* ============================================================
 * COMMON MODULE STYLE
 *
 * All normal indicators use this same background.
 * ============================================================ */

#clock,
#custom-batterycheck,
#cpu,
#memory,
#temperature,
#power-profiles-daemon,
#network,
#pulseaudio,
#custom-pacupdate,
#tray,
#custom-power,
#custom-pomodoro,
#custom-timer,
#mode {
    padding: 0 8px;
    margin: 2px 2px;

    border-radius: 10px;

    background-color: rgba(0, 0, 0, 0.3);
    color: #f8f8f2;
}

/* ============================================================
 * WINDOW TITLE
 * ============================================================ */

#window {
    /* font-family: "Ubuntu"; */
	font-family: "JetBrainsMono Nerd Font";
    font-weight: bold;

    margin-top: 2px;
    border-radius: 10px;
}

/* ============================================================
 * WORKSPACES
 * ============================================================ */

/* #workspaces { */
/*     padding: 0 4px; */
/*     margin: 2px 2px; */
/*     border-radius: 10px; */
/*     background-color: rgba(0, 0, 0, 0.3); */
/* } */

#workspaces {
    background-color: @surface_container;
    border-radius: 10px;
    margin: 2px;
    padding: 0 4px;
}

/* #workspaces button { */
/*     padding: 0 7px; */
/*     color: #f8f8f2; */
/*     background-color: transparent; */
/*     border: none; */
/*     border-radius: 7px; */
/* } */

/* Individual workspace */
#workspaces button {
    background-color: transparent;
    color: @on_surface;
}

/* Hover */
#workspaces button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

/* #workspaces button.focused { */
/*     color: #a9d18e; */
/*     background-color: rgba(169, 209, 142, 0.12); */
/*     border-top: 2px solid #a9d18e; */
/* } */


/* Focused */
#workspaces button.focused {
    background-color: @primary_container;
    color: @on_primary_container;
    border-top: 2px solid @primary;
}

/* Urgent */
#workspaces button.urgent {
    color: #ffffff;
    background-color: #eb4d4b;
}

/* ============================================================
 * MODE
 * ============================================================ */

#mode {
    color: #f8f8f2;
    background-color: #64727d;

    border-bottom: 3px solid #f8f8f2;
}

/* ============================================================
 * CLOCK
 * ============================================================ */

/* #clock { */
/*     color: #a9d18e; */
/*     font-weight: bold; */
/* } */

#clock {
    color: @primary;
    font-weight: bold;
}
/* ============================================================
 * CPU
 * ============================================================ */

#cpu {
    color: #f8f8f2;
}

/* ============================================================
 * MEMORY
 * ============================================================ */

#memory {
    color: #f8f8f2;
}

/* ============================================================
 * TEMPERATURE
 * ============================================================ */

#temperature {
    color: #f8f8f2;
}

/* ============================================================
 * POWER PROFILE
 * ============================================================ */

#power-profiles-daemon {
    color: #f8f8f2;
}

/* ============================================================
 * NETWORK
 * ============================================================ */

#network {
    color: #f8f8f2;
}

#network.disconnected {
    background-color: #f53c3c;
    color: #ffffff;
}

/* ============================================================
 * AUDIO
 * ============================================================ */

#pulseaudio {
    color: #f8f8f2;
}

#pulseaudio.muted {
    background-color: #f53c3c;
    color: #ffffff;
}

/* ============================================================
 * BATTERY CHECK
 *
 * Normal battery keeps the same background as every other
 * indicator. Only charging/warning/critical change it.
 * ============================================================ */

#custom-batterycheck {
    color: #f8f8f2;

    min-width: 26px;

    transition:
        color 200ms ease,
        background-color 200ms ease;
}

/* Battery icon */
#custom-batterycheck icon {
    color: #f8f8f2;
}

/* ----------------------------
 * Charging
 * ---------------------------- */

#custom-batterycheck.charging {
    color: #dfffe0;
    background-color: #268bd2;

    box-shadow: 0 0 6px rgba(38, 139, 210, 0.45);

    animation: charging-pulse 2s ease-in-out infinite;
}

#custom-batterycheck.charging icon {
    color: #dfffe0;
}

@keyframes charging-pulse {
    0% {
        background-color: #268bd2;
    }

    50% {
        background-color: #2f9ee8;
    }

    100% {
        background-color: #268bd2;
    }
}

/* ----------------------------
 * Battery Warning
 * ---------------------------- */

#custom-batterycheck.warning:not(.charging) {
    color: #ffffff;
    background-color: #f53c3c;

    box-shadow: 0 0 8px rgba(245, 60, 60, 0.5);

    animation: battery-warning 0.9s ease-in-out infinite alternate;
}

#custom-batterycheck.warning:not(.charging) icon {
    color: #ffffff;
}

@keyframes battery-warning {
    from {
        background-color: #f53c3c;
        box-shadow: 0 0 4px rgba(245, 60, 60, 0.35);
    }

    to {
        background-color: #ff6666;
        box-shadow: 0 0 10px rgba(245, 60, 60, 0.75);
    }
}

/* ----------------------------
 * Battery Critical
 * ---------------------------- */

#custom-batterycheck.critical:not(.charging) {
    color: #ffffff;
    background-color: #d90429;

    box-shadow: 0 0 10px rgba(217, 4, 41, 0.55);

    animation: battery-critical 0.6s ease-in-out infinite alternate;
}

#custom-batterycheck.critical:not(.charging) icon {
    color: #ffffff;
}

@keyframes battery-critical {
    from {
        background-color: #d90429;
        box-shadow: 0 0 5px rgba(217, 4, 41, 0.4);
    }

    to {
        background-color: #ff1744;
        box-shadow: 0 0 12px rgba(255, 23, 68, 0.8);
    }
}

/* ============================================================
 * PACMAN / SYSTEM UPDATES
 * ============================================================ */

#custom-pacupdate {
    color: #a9d18e;
}

/* ============================================================
 * POMODORO
 *
 * Same background as other modules.
 * State is communicated through text color.
 * ============================================================ */

#custom-pomodoro {
    padding: 0 10px;
    margin: 2px 2px;

    border-radius: 10px;

    background-color: rgba(0, 0, 0, 0.3);
    color: #ffffff;
}

/* Work */
#custom-pomodoro.work {
    color: #a9d18e;
}

/* Short break */
#custom-pomodoro.short-break {
    color: #a6e3a1;
}

/* Long break */
#custom-pomodoro.long-break {
    color: #89dceb;
}

/* Paused */
#custom-pomodoro.paused {
    color: #f9e2af;
}

/* Finished */
#custom-pomodoro.finished {
    color: #cba6f7;

    animation: pomodoro-finished 1s ease-in-out infinite;
}

/* Stopped */
#custom-pomodoro.stopped {
    color: #f38ba8;
}

@keyframes pomodoro-finished {
    0% {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }

    100% {
        opacity: 1;
    }
}

/* ============================================================
 * TIMER
 * ============================================================ */

#custom-timer {
    color: #89dceb;
}

#custom-timer.running {
    color: #a6e3a1;
}

#custom-timer.stopped {
    color: #f9e2af;
}

/* ============================================================
 * POWER BUTTON
 * ============================================================ */

#custom-power {
    color: #f8f8f2;
}

/* ============================================================
 * TRAY
 * ============================================================ */

#tray {
    color: #f8f8f2;
}

/* ============================================================
 * TOOLTIP
 * ============================================================ */

tooltip {
    font-size: 0.85rem;

    padding: 6px 10px;

    background-color: rgba(30, 30, 30, 0.94);
    color: #fafafa;

    border-radius: 5px;

    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
}
