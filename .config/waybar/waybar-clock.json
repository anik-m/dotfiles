{
    "clock": {
        "tooltip-format": "<tt>{calendar}</tt>",
        "format-alt": "{:%d-%m-%Y}",

        "calendar": {
            "mode": "month",

            "format": {
                "months": "<span color='#aec6ff' size='large'><b>{}</b></span>",
                "days": "<span color='#e2e2e9'><b>{}</b></span>",
                "weeks": "<span color='#bfc6dc'><b>W{}</b></span>",
                "weekdays": "<span color='#dfbcdf'><b>{}</b></span>",
                "today": "<span background='#aec6ff' color='#112f60'><b><u>{}</u></b></span>"
            }
        }
    }
}


