#!/usr/bin/env bash

WALLPAPER_DIR="$HOME/backgrounds/wallpapers"

if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
    # Get current wallpaper path
    CURRENT_WALL=$(hyprctl hyprpaper listloaded | head -n1)

    # Pick random wallpaper excluding current
    WALLPAPER=$(find "$WALLPAPER_DIR" -type f | grep -vxF "$CURRENT_WALL" | shuf -n1)

    # Preload and apply wallpaper
    hyprctl hyprpaper preload "$WALLPAPER"
    hyprctl hyprpaper wallpaper ",$WALLPAPER"

    # Optional: unload old wallpaper
    [[ -n "$CURRENT_WALL" ]] && \
        hyprctl hyprpaper unload "$CURRENT_WALL"
else
    feh --randomize --bg-fill "$WALLPAPER_DIR"
fi
