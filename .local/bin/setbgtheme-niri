#!/bin/bash

# ============================================================
# wallpaper + dynamic theme
# ============================================================

wallpaper_dir="$HOME/backgrounds/wallpapers"

# last_wallpaper="$home/.cache/current-wallpaper"
# mkdir -p "$(dirname "$last_wallpaper")"

# ============================================================
# transition settings
# ============================================================

transition_type="wipe"
transition_angle="30"
transition_duration="0.5"

# ============================================================
# start awww daemon if not running
# ============================================================

if ! pgrep -x "awww-daemon" > /dev/null; then
    echo "starting awww-daemon..."
    awww-daemon &
    sleep 0.5
fi

# ============================================================
# find wallpapers
# ============================================================

mapfile -t images < <(
    find -L "$wallpaper_dir" -type f \
        \( -iname "*.jpg" \
        -o -iname "*.jpeg" \
        -o -iname "*.png" \
        -o -iname "*.webp" \)
)

if [ ${#images[@]} -eq 0 ]; then
    echo "no images found in $wallpaper_dir"
    exit 1
fi

# ============================================================
# pick random wallpaper
# ============================================================


# while true; do
#     random_image="${images[random % ${#images[@]}]}"
#
#     if [[ ! -f "$last_wallpaper" ]] || \
#        [[ "$random_image" != "$(cat "$last_wallpaper")" ]]; then
#         break
#     fi
# done

# printf '%s\n' "$random_image" > "$last_wallpaper"

# random_image="${images[random % ${#images[@]}]}"

random_image="${images[RANDOM % ${#images[@]}]}"
echo "wallpaper: $random_image"

# ============================================================
# set wallpaper
# ============================================================

awww img "$random_image" \
    --transition-type "$transition_type" \
    --transition-duration "$transition_duration" \
    --transition-angle "$transition_angle" \
    --resize crop



#for random choice from colors gotten
# source_colors=$(matugen image "$random_image" --show-source-colors)
# source_color_count=$(printf '%s\n' "$source_colors" | grep -Ec '^#[0-9a-fA-F]{6}$')
#
# if [ "$source_color_count" -eq 0 ]; then
#     echo "error: no source colors found"
#     exit 1
# fi
#
# source_color_index=$((RANDOM % source_color_count))
#
# echo "matugen source colors:"
# printf '%s\n' "$source_colors"
# echo "selected source color index: $source_color_index"
#
# matugen image "$random_image" \
#     -m dark \
#     --source-color-index "$source_color_index"
#
# echo "matugen exit status: $matugen_status"
#
# if [ "$matugen_status" -ne 0 ]; then
#     echo "error: matugen failed"
#     exit 1
# fi

# echo "selected wallpaper: $random_image"
# echo "source colors:"
# matugen image "$random_image" --show-source-colors


# #First choice from colors
# ============================================================
# determine wallpaper brightness from dominant source color
# ============================================================

source_color=$(matugen image "$random_image" --show-source-colors | head -n 1)

if [[ ! "$source_color" =~ ^#[0-9a-fA-F]{6}$ ]]; then
    echo "error: could not determine dominant source color"
    echo "source color: $source_color"
    exit 1
fi

hex="${source_color#\#}"

r=$((16#${hex:0:2}))
g=$((16#${hex:2:2}))
b=$((16#${hex:4:2}))

brightness=$(( (299 * r + 587 * g + 114 * b) / 1000 ))

echo "dominant source color: $source_color"
echo "RGB: $r $g $b"
echo "brightness: $brightness"

# ============================================================
# choose Matugen mode
# ============================================================

if (( brightness <= 128 )); then
    matugen_mode="dark"
    echo "dark wallpaper → using dark Matugen theme"
else
    matugen_mode="light"
    echo "bright wallpaper → using light Matugen theme"
fi

# ============================================================
# generate theme
# ============================================================

matugen image "$random_image" \
    -m "$matugen_mode" \
    --source-color-index 0

matugen_status=$?

echo "matugen exit status: $matugen_status"

if [ "$matugen_status" -ne 0 ]; then
    echo "error: matugen failed"
    exit 1
fi

echo "matugen finished successfully"

pkill -sigusr2 waybar

echo "waybar reload requested"

# ============================================================
# notification
# ============================================================

# notify-send \
#     "wallpaper changed" \
#     "$(basename "$random_image")"
