
#!/usr/bin/env bash

set -u

wallpaper_dir="$HOME/backgrounds/wallpapers"

# ============================================================
# find wallpapers
# ============================================================

mapfile -t images < <(
    find "$wallpaper_dir" -type f \
        \( -iname "*.jpg" \
        -o -iname "*.jpeg" \
        -o -iname "*.png" \
        -o -iname "*.webp" \) \
        -print
)

if [ "${#images[@]}" -eq 0 ]; then
    echo "error: no images found in $wallpaper_dir"
    exit 1
fi

# ============================================================
# pick random wallpaper
# ============================================================

random_image="${images[RANDOM % ${#images[@]}]}"

echo "wallpaper: $random_image"

# ============================================================
# set wallpaper
# ============================================================

feh --no-fehbg --bg-fill "$random_image"

feh_status=$?

if [ "$feh_status" -ne 0 ]; then
    echo "error: feh failed with status $feh_status"
    exit 1
fi

# ============================================================
# determine wallpaper brightness
# ============================================================

source_color=$(matugen image "$random_image" --show-source-colors | head -n 1)

if [[ ! "$source_color" =~ ^#[0-9a-fA-F]{6}$ ]]; then
    echo "error: could not determine dominant source color"
    echo "source color: $source_color"
    exit 1
fi

hex="${source_color#\#}"

r=$((16#${hex:0:2}))
g=$((16#${hex:2:2}))
b=$((16#${hex:4:2}))

brightness=$(( (299 * r + 587 * g + 114 * b) / 1000 ))

echo "dominant source color: $source_color"
echo "RGB: $r $g $b"
echo "brightness: $brightness"

# ============================================================
# choose Matugen mode
# ============================================================

if (( brightness <= 128 )); then
    matugen_mode="dark"
    echo "dark wallpaper -> using dark Matugen theme"
else
    matugen_mode="light"
    echo "bright wallpaper -> using light Matugen theme"
fi

# ============================================================
# generate theme
# ============================================================

matugen image "$random_image" \
    -m "$matugen_mode" \
    --source-color-index 0

matugen_status=$?

echo "matugen exit status: $matugen_status"

if [ "$matugen_status" -ne 0 ]; then
    echo "error: matugen failed"
    exit 1
fi

echo "matugen finished successfully"

# ============================================================
# reload X11 programs
# ============================================================

~/.config/polybar/launch.sh

pkill -SIGUSR2 dunst 2>/dev/null || true

echo "theme reload requested"

# ============================================================
# reload XMonad
# ============================================================

xmonad --recompile
xmonad --restart

echo "xmonad reload requested"
